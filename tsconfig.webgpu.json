{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "types": [
      "bun",
      "@webgpu/types"
    ]
  },
  "include": [
    "bend2/webgpu/*.ts",
    "bend2/webgpu/*.mjs",
    "tools/webgpu/build-webgpu.ts",
    "tools/webgpu/build-hybrid.ts"
  ]
}
